# Salin file ini ke .env dan isi nilainya.
# Anon key aman untuk client-side (public). Service role key TIDAK BOLEH pernah ada di repo.

# public-site & admin-panel (config.js)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Base URL publik untuk menampilkan tautan pendek di admin panel (mis. https://shortic.teguh.my.id)
# Hanya dibutuhkan di project admin-panel.
PUBLIC_BASE_URL=https://YOUR-PUBLIC-DOMAIN

# GitHub Actions (secrets)
# SUPABASE_URL
# SUPABASE_ANON_KEY